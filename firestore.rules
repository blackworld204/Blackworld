rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Signed-in users can reach the desk because the server uses their token.
    // The account book is sealed before it is stored, and the browser does not
    // read desks/presentation itself. Profile photos live in desks/photo_*.
    match /desks/{deskId} {
      allow read, write: if request.auth != null;
    }
  }
}
